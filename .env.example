# ---------------------------------------------------------------- identity
APP_ENV=development
APP_NAME=Resonance
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------- storage
# SQLite for local dev; PostgreSQL (with pgvector) for production.
DATABASE_URL=sqlite+aiosqlite:///./data/resonance.db
# DATABASE_URL=postgresql+asyncpg://resonance:resonance@localhost:5432/resonance

# ---------------------------------------------------------------- secrets
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
# base64 of 32 random bytes, e.g. python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------- privacy invariants
K_ANON_MIN=10
DAILY_CARD_BUDGET=3
FIT_THRESHOLD=80
TRANSCRIPT_TTL_SECONDS=1800

# ---------------------------------------------------------------- sandbox economics
SANDBOX_TOPK=20
SANDBOX_MAX_PAIRS=4000
SANDBOX_CONCURRENCY=6

# ---------------------------------------------------------------- model access
# LLM_MODE: auto (live if a key is present) | live | deterministic
LLM_MODE=auto
# Any OpenAI-compatible endpoint: OpenAI, Azure, vLLM, Ollama, a gateway, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_SMALL=qwen3.6-35b-fast
LLM_MODEL_LARGE=nw-flash-flex
# Structured scoring must use a NON-reasoning model: reasoning models can spend the
# whole token budget in the reasoning channel and return empty content, which turns
# every judge call into a silent fallback. Empty -> reuse LLM_MODEL_SMALL.
LLM_MODEL_JUDGE=qwen3.6-35b-fast
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENCY=8
# The large tier only polishes the icebreaker of a *gated* pair. It is the single most
# expensive line item (~90% of token spend in the measured runs); set false to reuse the
# judge tier instead and accept slightly flatter one-liners.
POLISH_WITH_LARGE_MODEL=true
# USD per 1M tokens, used only for the cost ledger
PRICE_SMALL_IN=0.15
PRICE_SMALL_OUT=0.60
PRICE_LARGE_IN=2.50
PRICE_LARGE_OUT=10.00

# ---------------------------------------------------------------- ops
SEED_ON_START=true
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=240




